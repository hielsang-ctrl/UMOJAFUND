# Put comments on their own line (never after a value).

# ---------- Django ----------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- PostgreSQL ----------
DATABASE_URL=postgres://umoja:umoja@localhost:5432/umoja

# ---------- Fund rules ----------
TARGET_PER_MEMBER=5000
GROUP_NAME=Umoja Group Fund

# ---------- M-Pesa Daraja ----------
# sandbox or production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# STK Push (collections). 174379 is the sandbox shortcode; use your own Paybill/Till in production.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# CustomerPayBillOnline for a Paybill, CustomerBuyGoodsOnline for a Till
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Leave empty to use MPESA_SHORTCODE. For a Till, put the Till number here.
MPESA_PARTY_B=

# B2C (savings payouts)
MPESA_B2C_SHORTCODE=600992
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
MPESA_CERT_PATH=apps/mpesa/certs/SandboxCertificate.cer

# Callbacks must be a PUBLIC https URL (ngrok or cloudflared while developing)
# Optional shortcut: a ready-made SecurityCredential string. When set, the certificate and initiator password are not used.
MPESA_SECURITY_CREDENTIAL=paste-the-long-string-here
MPESA_CALLBACK_BASE_URL=https://your-public-domain.example
MPESA_CALLBACK_SECRET=another-long-random-string
# Optional comma-separated IPs allowed to call the callbacks. Empty = off.
MPESA_CALLBACK_ALLOWED_IPS=

# ---------- Email / SMS ----------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Umoja Fund <no-reply@umojafund.co.ke>
